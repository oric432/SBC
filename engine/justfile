# List available engine commands
default:
    @just --list

# Install dependencies and perform initial setup
setup:
    @echo "Engine has no explicit setup step (CMake is handled during build)"

# Configure and build the C++ engine in debug mode
build-dev:
    cmake --preset debug
    cmake --build --preset build-debug

# Configure and build the C++ engine in release mode
build-release:
    cmake --preset release
    cmake --build --preset build-release

# Configure and build in debug mode with clang-tidy on (weekly full-repo sweep only)
build-ci:
    cmake --preset ci-debug
    cmake --build --preset build-ci-debug

# Run clang-tidy on .cpp files changed since `base` (merge-base diff). Per-PR
# CI uses this instead of a full-tree scan to keep build time down; the
# weekly sweep (build-ci) covers files this misses, e.g. a header-only change
# whose includers weren't touched in the same PR.
lint-changed base="origin/main":
    #!/usr/bin/env bash
    set -euo pipefail
    merge_base=$(git merge-base {{base}} HEAD 2>/dev/null || echo HEAD~1)
    mapfile -t files < <(git diff --relative --name-only --diff-filter=ACMR "$merge_base" HEAD -- '*.cpp')
    if [ ${#files[@]} -eq 0 ]; then
        echo "No changed .cpp files to lint."
        exit 0
    fi
    printf 'Linting %d changed file(s):\n' "${#files[@]}"
    printf '  %s\n' "${files[@]}"
    clang-tidy -p build "${files[@]}"

# Run the engine in debug mode
run-dev:
    cd build && ./SbcEngine

# Run the engine in release mode
run-release:
    cd build && ./SbcEngine

# Configure and build in debug mode with ASan+UBSan on (required CI check)
build-asan:
    cmake --preset asan-ubsan
    cmake --build --preset build-asan-ubsan

# Configure and build in debug mode with TSan on (weekly scheduled check)
build-tsan:
    cmake --preset tsan
    cmake --build --preset build-tsan

# Run standard C++ tests
test:
    ctest --preset test-debug

# Run standard C++ tests (weekly full-repo sweep only, matches build-ci preset)
test-ci:
    ctest --preset test-ci-debug --output-on-failure

# Run tests under ASan+UBSan (CI only, matches build-asan preset)
test-asan:
    ctest --preset test-asan-ubsan --output-on-failure

# Run tests under TSan (weekly scheduled CI only, matches build-tsan preset)
test-tsan:
    ctest --preset test-tsan --output-on-failure

# Check formatting without modifying files (CI-safe)
format-check:
    cmake --build build --target format-check

format:
    cmake --build build --target format

# Run B2BUA integration tests (builds+starts the engine itself; sipp must be installed)
test-b2bua *args:
    #!/usr/bin/env bash
    set -e

    SIPP_BIN="$(command -v sipp || true)"
    if [[ -z "$SIPP_BIN" ]]; then
        echo "error: SIPp is not installed or is not in PATH" >&2
        exit 1
    fi

    # play_pcap_audio opens a raw socket. Non-root runs therefore require
    # CAP_NET_RAW on the SIPp executable.
    if [[ $EUID -ne 0 ]] && ! getcap "$(readlink -f "$SIPP_BIN")" 2>/dev/null | grep -q 'cap_net_raw'; then
        echo "error: SIPp needs CAP_NET_RAW to replay tests/integration/b2bua/g711a.pcap" >&2
        echo "run once: sudo setcap cap_net_raw+ep \"$(readlink -f "$SIPP_BIN")\"" >&2
        exit 1
    fi

    # A project-local venv sidesteps PEP 668 (Debian/Ubuntu's system Python
    # refuses `pip install` outside a venv) and matches what CI does after
    # `actions/setup-python`.
    VENV="tests/.venv"
    if [[ ! -x "$VENV/bin/python" ]]; then
        python3 -m venv "$VENV"
    fi
    "$VENV/bin/pip" install --quiet ./tests
    "$VENV/bin/pytest" tests/integration/b2bua {{args}}

# Generate schemas using the schema generator tool
generate-schemas:
    cmake --preset schema-gen-only
    cmake --build --preset build-schema-gen
    cd build && ./tools/schema_generator
