<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<scenario name="{{ scenario_name }}">
  <send retrans="500">
    <![CDATA[
      INVITE sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Subject: SBC Test
      Supported: 100rel
      Require: 100rel
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <recv response="100" optional="true"></recv>

  <!-- Same reliable early-answer setup as caller_prack_early_media.xml.j2:
       this leg's own negotiator resolves via PRACK below, opening issue
       #211's gate (OfferAnswerExchange::early_media_relayed()) well before
       the initial exchange itself is Established. -->
  <recv response="183">
    <action>
      <ereg regexp="[0-9]+" search_in="hdr" header="RSeq:" check_it="true" assign_to="rseq"/>
      <ereg regexp="application/sdp" search_in="hdr" header="Content-Type:" check_it="true" assign_to="early_ct"/>
      <log message="reliable early media 183 carried an SDP answer (RSeq=[$rseq], Content-Type=[$early_ct])"/>
    </action>
  </recv>

  <send retrans="500">
    <![CDATA[
      PRACK sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 2 PRACK
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      RAck: [$rseq] 1 INVITE
      Content-Length: 0
    ]]>
  </send>

  <recv response="200"></recv>

  <!-- Issue #211: this leg's own negotiator is DONE once the PRACK above
       completes, so PJSIP lets this offer-bearing UPDATE through well before
       the callee has even sent its final 200 OK to the initial INVITE.
       Answered locally, same negotiate_mid_dialog_offer() path re-INVITE and
       confirmed-dialog UPDATE already share (#116). -->
  <send retrans="500">
    <![CDATA[
      UPDATE sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 3 UPDATE
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Subject: SBC Test
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687638 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 9
      a=rtpmap:9 G722/8000
    ]]>
  </send>

  <recv response="200" rtd="true">
    <action>
      <ereg regexp="m=audio [1-9][0-9]* RTP/AVP 9" search_in="body" check_it="true" assign_to="update_answer_codec"/>
      <log message="early UPDATE answered with [$update_answer_codec]"/>
    </action>
  </recv>

  <!-- The callee-facing leg (callee_prack_183.xml.j2) pauses before its own
       200 OK so this always arrives after the exchange above, never racing
       it. RFC 3262 S5 still requires this leg's own final 200 OK to NOT
       repeat the answer, unaffected by the UPDATE having since changed the
       negotiator's active local SDP to G722. -->
  <recv response="200" rtd="true">
    <action>
      <ereg regexp="^\s*0\s*$" search_in="hdr" header="Content-Length:" check_it="true" assign_to="final_cl"/>
      <log message="final 200 OK carried no SDP body, as required once this leg's own negotiation was reliable (Content-Length=[$final_cl])"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      ACK sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Subject: SBC Test
      Content-Length: 0
    ]]>
  </send>

  <nop>
    <action>
      <exec play_pcap_audio="{{ g722_pcap_path }}"/>
    </action>
  </nop>

  <pause milliseconds="2000"/>

  <send retrans="500">
    <![CDATA[
      BYE sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 4 BYE
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <recv response="200" crlf="true"></recv>
</scenario>
