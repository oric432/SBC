<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<scenario name="{{ scenario_name }}">
  {% set aor_user = to_username | default(username) %}
  <send retrans="500">
    <![CDATA[
      REGISTER sip:{{ realm }} SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: {{ username }} <sip:{{ username }}@{{ realm }}>;tag=[pid]SIPpTag00[call_number]
      To: {{ aor_user }} <sip:{{ aor_user }}@{{ realm }}>
      Call-ID: [call_id]
      CSeq: 1 REGISTER
      Contact: <sip:{{ aor_user }}@[local_ip]:[local_port]>
      Max-Forwards: 70
      Expires: {{ expires }}
      Content-Length: 0
    ]]>
  </send>

  <recv response="401" auth="true"></recv>

  <send retrans="500">
    <![CDATA[
      REGISTER sip:{{ realm }} SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: {{ username }} <sip:{{ username }}@{{ realm }}>;tag=[pid]SIPpTag00[call_number]
      To: {{ aor_user }} <sip:{{ aor_user }}@{{ realm }}>
      Call-ID: [call_id]
      CSeq: 2 REGISTER
      Contact: <sip:{{ aor_user }}@[local_ip]:[local_port]>
      Max-Forwards: 70
      Expires: {{ expires }}
      [authentication username={{ username }} password={{ password }}]
      Content-Length: 0
    ]]>
  </send>

  <recv response="{{ expected_status }}"></recv>

</scenario>
