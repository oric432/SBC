<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<scenario name="{{ scenario_name }}">
  <recv request="INVITE" crlf="true">
    <action>
      <ereg regexp="tag=([^;[:space:]&gt;]+)" search_in="hdr" header="From:" check_it="true" assign_to="from_tag_match,outgoing_from_tag"/>
      <ereg regexp="([^[:space:]]+)" search_in="hdr" header="Call-ID:" check_it="true" assign_to="outgoing_call_id"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true"></recv>

  <!-- No pause between this and the BYE recv below: an explicit pause would
       block this call's scenario progression and risk the caller's BYE
       arriving before a recv step is active to catch it. The pcap keeps
       streaming in the background regardless of scenario position, so the
       caller's own holds_ms loop is what actually controls call length. -->
  <nop>
    <action>
      <exec play_pcap_audio="{{ pcap_path }}"/>
    </action>
  </nop>

  <recv request="REFER" crlf="true">
    <action>
      <ereg regexp="sip:transfer@" search_in="hdr" header="Refer-To:" check_it="true" assign_to="refer_target"/>
      <ereg regexp="Replaces=[^%]+%3bto-tag%3d[^%]+%3bfrom-tag%3d[^&amp;&gt;]+" search_in="hdr" header="Refer-To:" check_it="true" assign_to="translated_replaces"/>
      <ereg regexp="sip:transferor@example.com" search_in="hdr" header="Referred-By:" check_it="true" assign_to="referred_by"/>
{% if peer_accepts %}
      <ereg regexp="(.*)" search_in="hdr" header="From:" check_it="true" assign_to="refer_from"/>
      <ereg regexp="(.*)" search_in="hdr" header="To:" check_it="true" assign_to="refer_to"/>
      <ereg regexp="sip:[^&gt;[:space:]]+" search_in="hdr" header="Contact:" check_it="true" assign_to="refer_contact"/>
{% endif %}
      <log message="REFER target: [$refer_target], call: [$outgoing_call_id], caller tag: [$from_tag_match]/[$outgoing_from_tag], replacements: [$translated_replaces], referred by: [$referred_by]"/>
    </action>
  </recv>
{% if peer_accepts %}
  <send><![CDATA[
      SIP/2.0 202 Accepted
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
  ]]></send>

{% if bye_during_refer %}
  <recv request="BYE" crlf="true"></recv>
  <send><![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
  ]]></send>
{% else %}
  <pause milliseconds="{{ final_notify_delay_ms }}"/>
{% endif %}

  <send retrans="500"><![CDATA[
      NOTIFY [$refer_contact] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: [$refer_to]
      To: [$refer_from]
      Call-ID: [$outgoing_call_id]
      CSeq: 2 NOTIFY
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Event: refer
      Subscription-State: terminated;reason=noresource
      Content-Type: message/sipfrag
      Content-Length: [len]

      SIP/2.0 {{ notify_status }} {{ "OK" if notify_status == 200 else "Failure" }}
  ]]></send>
  <recv response="200" crlf="true"></recv>
{% else %}
  <send><![CDATA[
      SIP/2.0 486 Busy Here
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
  ]]></send>
{% endif %}

{% if not bye_during_refer %}
  <recv request="BYE" crlf="true"></recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>
{% endif %}
</scenario>
