<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<scenario name="{{ scenario_name }}">
  <send retrans="500">
    <![CDATA[
      INVITE sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Subject: SBC Test
      Allow: INVITE, ACK, BYE, CANCEL, PRACK, UPDATE
      Supported: 100rel
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <recv response="100" optional="true"></recv>

  <!-- Supported only, never Require, same as caller_early_media.xml.j2 -- the
       SBC's early-media relay (#219) already armed the bridge on this 183, so
       its own gate for issue #211 (early_media_relayed()) is open even though
       this leg is nowhere near Established yet. -->
  <recv response="183">
    <action>
      <ereg regexp="application/sdp" search_in="hdr" header="Content-Type:" check_it="true" assign_to="early_ct"/>
      <log message="early media 183 carried an SDP answer (Content-Type=[$early_ct])"/>
    </action>
  </recv>

  <!-- Issue #211: an offer-bearing UPDATE sent before the initial INVITE's
       final response, now that this leg's own negotiator is DONE via the
       early answer above. Unlike update_new_codec_caller.xml.j2's confirmed-
       dialog case, this exercises the pjsip_inv_answer() `last_answer` clone:
       it was cloned from the 183 above, so the final 200 OK's body must be
       refreshed from this UPDATE's answer rather than replaying the 183's
       stale PCMU SDP (see Inv::answer_with_active_local()). -->
  <send retrans="500">
    <![CDATA[
      UPDATE sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 2 UPDATE
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Subject: SBC Test
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687638 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 9
      a=rtpmap:9 G722/8000
    ]]>
  </send>

  <recv response="200" rtd="true">
    <action>
      <ereg regexp="m=audio [1-9][0-9]* RTP/AVP 9" search_in="body" check_it="true" assign_to="update_answer_codec"/>
      <log message="early UPDATE answered with [$update_answer_codec]"/>
    </action>
  </recv>

  <!-- The regression assertion for the last_answer bug: without
       answer_with_active_local(), this would still carry the 183's PCMU body. -->
  <recv response="200" rtd="true">
    <action>
      <ereg regexp="m=audio [1-9][0-9]* RTP/AVP 9" search_in="body" check_it="true" assign_to="final_codec"/>
      <log message="final 200 OK carried the post-UPDATE codec ([$final_codec]), not the stale pre-UPDATE answer"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      ACK sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Subject: SBC Test
      Content-Length: 0
    ]]>
  </send>

  <nop>
    <action>
      <exec play_pcap_audio="{{ g722_pcap_path }}"/>
    </action>
  </nop>

  <pause milliseconds="2000"/>

  <send retrans="500">
    <![CDATA[
      BYE sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 3 BYE
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <recv response="200" crlf="true"></recv>
</scenario>
