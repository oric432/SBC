      "targets": [{ "kind": "sip", "address": "198.51.100.30", "port": 5060, "timeout_ms": 1000 }],
      "rewrite": {}
    },
    {
      "id": "source-network",
      "match": { "dest_pattern": "_555.", "source_cidr": ["192.0.2.0/24"] },
      "action": "route",
      "priority": 900,
      "targets": [{ "kind": "sip", "address": "198.51.100.31", "port": 5060, "timeout_ms": 1000 }],
      "rewrite": {}
    },
    {
      "id": "source-narrow",
      "match": { "dest_pattern": "_555.", "source_cidr": ["192.0.2.0/25"] },
      "action": "route",
      "priority": 999,
      "targets": [{ "kind": "sip", "address": "198.51.100.32", "port": 5060, "timeout_ms": 1000 }],
      "rewrite": {}
    },
    {
      "id": "source-user",
      "match": { "dest_pattern": "_555.", "source_cidr": ["192.0.2.0/24"], "source_user": "alice" },
      "action": "route",
      "priority": 999,
      "targets": [{ "kind": "sip", "address": "198.51.100.33", "port": 5060, "timeout_ms": 1000 }],
      "rewrite": {}
    },
    {
      "id": "source-user-120",
      "match": { "dest_pattern": "_120.", "source_cidr": [], "source_user": "alice" },
      "action": "route",
      "priority": 1,
      "targets": [{ "kind": "sip", "address": "198.51.100.34", "port": 5060, "timeout_ms": 1000 }],
      "rewrite": {}
    },
    {
      "id": "ipv4-wide",
