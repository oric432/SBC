{
  "schema_version": 1,
  "matching": {
    "dest_pattern": "Asterisk-style patterns begin with '_'; _. is the catch-all pattern.",
    "source_ranking": "source_user outranks source_cidr; a narrower CIDR outranks a wider CIDR; both outrank an unconstrained source.",
    "priority": "Lower numeric priority wins when destination specificity and source ranking tie.",
    "reject": "A reject action wins when every other ranking factor, including priority, ties.",
    "final_tie_breaker": "Equal actions after every ranking factor use ascending lexical rule ID; rule IDs must be unique within a snapshot."
  },
  "rules": [
    {
      "id": "default",
      "match": { "dest_pattern": "_.", "source_cidr": [] },
      "action": "route",
      "priority": 100,
      "targets": [{ "kind": "sip", "address": "198.51.100.1", "port": 5060, "timeout_ms": 1000 }],
      "rewrite": {}
    },
    {
      "id": "prefix-1",
      "match": { "dest_pattern": "_1.", "source_cidr": [] },
      "action": "route",
      "priority": 100,
      "targets": [{ "kind": "sip", "address": "198.51.100.10", "port": 5060, "timeout_ms": 1000 }],
      "rewrite": {}
    },
    {
      "id": "prefix-120",
      "match": { "dest_pattern": "_120.", "source_cidr": [] },
      "action": "route",
      "priority": 900,
      "targets": [{ "kind": "sip", "address": "198.51.100.20", "port": 5060, "timeout_ms": 1000 }],
      "rewrite": {}
    },
    {
      "id": "exact-1205555",
      "match": { "dest_pattern": "1205555", "source_cidr": [] },
      "action": "route",
      "priority": 999,
      "targets": [{ "kind": "sip", "address": "198.51.100.21", "port": 5060, "timeout_ms": 1000 }],
      "rewrite": {}
    },
    {
