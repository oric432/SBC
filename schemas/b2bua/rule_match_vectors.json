      "priority": 999,
      "targets": [{ "kind": "sip", "address": "198.51.100.36", "port": 5060, "timeout_ms": 1000 }],
      "rewrite": {}
    },
    {
      "id": "priority-low",
      "match": { "dest_pattern": "_700.", "source_cidr": [] },
      "action": "route",
      "priority": 10,
      "targets": [{ "kind": "sip", "address": "198.51.100.40", "port": 5060, "timeout_ms": 1000 }],
      "rewrite": {}
    },
    {
      "id": "priority-high",
      "match": { "dest_pattern": "_700.", "source_cidr": [] },
      "action": "route",
      "priority": 20,
      "targets": [{ "kind": "sip", "address": "198.51.100.41", "port": 5060, "timeout_ms": 1000 }],
      "rewrite": {}
    },
    {
      "id": "tie-route",
      "match": { "dest_pattern": "_900.", "source_cidr": [] },
      "action": "route",
      "priority": 50,
      "targets": [{ "kind": "sip", "address": "198.51.100.50", "port": 5060, "timeout_ms": 1000 }],
      "rewrite": {}
    },
    {
      "id": "tie-reject",
      "match": { "dest_pattern": "_900.", "source_cidr": [] },
      "action": "reject",
      "priority": 50,
      "targets": [],
      "rewrite": {}
    },
    {
      "id": "same-action-z",
      "match": { "dest_pattern": "_800.", "source_cidr": [] },
      "action": "route",
      "priority": 50,
      "targets": [{ "kind": "sip", "address": "198.51.100.60", "port": 5060, "timeout_ms": 1000 }],
      "rewrite": {}
    },
    {
      "id": "same-action-a",
      "match": { "dest_pattern": "_800.", "source_cidr": [] },
      "action": "route",
      "priority": 50,
      "targets": [{ "kind": "sip", "address": "198.51.100.61", "port": 5060, "timeout_ms": 1000 }],
      "rewrite": {}
    }
  ],
  "cases": [
    { "name": "exact destination", "dialed_number": "1205555", "source": { "address": "203.0.113.1" }, "expected": { "action": "route", "rule_id": "exact-1205555" } },
    { "name": "pattern destination", "dialed_number": "120999", "source": { "address": "203.0.113.1" }, "expected": { "action": "route", "rule_id": "prefix-120" } },
    { "name": "default destination", "dialed_number": "888", "source": { "address": "203.0.113.1" }, "expected": { "action": "route", "rule_id": "default" } },
    { "name": "narrow CIDR", "dialed_number": "5551234", "source": { "address": "192.0.2.10" }, "expected": { "action": "route", "rule_id": "source-narrow" } },
    { "name": "source user", "dialed_number": "5551234", "source": { "address": "192.0.2.10", "user": "alice" }, "expected": { "action": "route", "rule_id": "source-user" } },
    { "name": "source user absent", "dialed_number": "5551234", "source": { "address": "192.0.2.10" }, "expected": { "action": "route", "rule_id": "source-narrow" } },
    { "name": "source user differs", "dialed_number": "5551234", "source": { "address": "192.0.2.10", "user": "bob" }, "expected": { "action": "route", "rule_id": "source-narrow" } },
    { "name": "invalid source does not match CIDR", "dialed_number": "5551234", "source": { "address": "not-an-address" }, "expected": { "action": "route", "rule_id": "source-any" } },
    { "name": "IPv4 narrow CIDR", "dialed_number": "6001234", "source": { "address": "198.18.0.10" }, "expected": { "action": "route", "rule_id": "ipv4-narrow" } },
    { "name": "same-action tie uses rule ID", "dialed_number": "8001234", "source": { "address": "203.0.113.1" }, "expected": { "action": "route", "rule_id": "same-action-a" } },
    { "name": "destination outranks source", "dialed_number": "1205555", "source": { "address": "203.0.113.1", "user": "alice" }, "expected": { "action": "route", "rule_id": "exact-1205555" } },
    { "name": "priority", "dialed_number": "7001234", "source": { "address": "203.0.113.1" }, "expected": { "action": "route", "rule_id": "priority-low" } },
    { "name": "reject tie", "dialed_number": "9001234", "source": { "address": "203.0.113.1" }, "expected": { "action": "reject", "rule_id": "tie-reject" } },
    { "name": "no match rejects", "dialed_number": "", "source": { "address": "203.0.113.1" }, "expected": { "action": "reject", "rule_id": null } }
  ]
}
